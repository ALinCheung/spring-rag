# =============================================================================
# Spring Boot 3.3 + Maven + Java 17 + ONNX Runtime 本地 RAG 项目
# 不使用: Python / Node / NetBeans / EAR / 外部数据库 / Docker
# =============================================================================

# -----------------------------------------------------------------------------
# 一、Java 编译产物
# -----------------------------------------------------------------------------
*.class
*.jar
*.war
*.zip
*.tar.gz

# JVM 崩溃日志与堆转储
hs_err_pid*
*.hprof
*.jfr

# -----------------------------------------------------------------------------
# 二、Maven 构建输出与配置
# -----------------------------------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml

# Maven Wrapper 自身 (Maven 官方建议纳入版本控制，忽略本地用户 wrapper 配置)
# 取消下面两行注释以忽略 wrapper
# .mvn/wrapper/maven-wrapper.jar
# .mvn/wrapper/MavenWrapperDownloader.properties

# -----------------------------------------------------------------------------
